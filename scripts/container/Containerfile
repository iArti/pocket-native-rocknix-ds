# the build environment: Ubuntu 18.04, whose C library is old enough for the
# handhelds' systems, with the ARM64 cross compiler, Rust and Python
FROM docker.io/library/ubuntu:18.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        gcc g++ libc6-dev gcc-aarch64-linux-gnu gcc-8-aarch64-linux-gnu libc6-dev-arm64-cross binutils-aarch64-linux-gnu \
        make pkg-config ca-certificates curl zstd python3 python3-pip python3-setuptools \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir pycryptodomex
ENV RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | CARGO_HOME=/opt/cargo sh -s -- -y --profile minimal --component rustfmt,clippy --no-modify-path --target aarch64-unknown-linux-gnu \
    && chmod -R a+rX /opt/rustup /opt/cargo
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
